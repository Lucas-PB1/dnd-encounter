rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for validation
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { 
      return request.resource.data; 
    }

    // 2. Secured Combat Sessions Collection
    match /combatSessions/{sessionCode} {
      allow read, write: if true;
    }

    // 3. User Profiles
    match /userProfiles/{username} {
      allow read, write: if true;
    }

    // 4. Configured Characters Pre-Deck
    match /characters/{charId} {
      allow read, write: if true;
    }

    // 5. Saved Scenarios
    match /savedCombats/{combatId} {
      allow read, write: if true;
    }
  }
}
